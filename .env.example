# Copy to .env.local and fill in. Never commit real keys.

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random string, 32+ characters: signs refund, unsubscribe and billing links in emails.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Brand (open question in the requirements doc; one place to change it)
NEXT_PUBLIC_BRAND_NAME=Quiz Platform
NEXT_PUBLIC_COMPANY_NAME=Quiz Platform
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Postgres (Supabase or Neon). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host:5432/postgres
DATABASE_POOL_SIZE=5

# Clerk — https://dashboard.clerk.com → API keys. Leave both blank locally to use the dev sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint /api/webhooks/clerk, events user.created + user.updated
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Admins (verified emails, comma-separated) can edit and publish quizzes at /admin
ADMIN_EMAILS=

# Stripe — https://dashboard.stripe.com/test/apikeys. `npm run stripe:setup` prints the rest.
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints this locally
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SNAPSHOT=
STRIPE_PRICE_SNAPSHOT_TEST=
STRIPE_PRICE_DEEP=
STRIPE_PRICE_COMPARISON=
STRIPE_PRICE_BUNDLE=
STRIPE_PRICE_ALL_ACCESS=
STRIPE_PORTAL_CONFIGURATION=
# Turn on once Stripe Tax is configured in the dashboard
STRIPE_AUTOMATIC_TAX=false
# Adds Stripe's own "I agree to the Terms" checkbox to checkout (needs a Terms URL in Stripe settings)
STRIPE_TOS_CONSENT=false

# Email (Resend). Without a key, emails are logged and visible at /dev/outbox in development.
RESEND_API_KEY=
EMAIL_FROM=Quiz Platform <hello@yourdomain.com>

# Win-back emails (daily cron, only to people who opted in). Vercel Cron sends CRON_SECRET.
CRON_SECRET=
# A Stripe promotion code customers can type at checkout (one-time discount, second win-back email)
WINBACK_PROMO_CODE=

# Analytics (loaded only after cookie consent). Server-side purchase events use GA_API_SECRET.
NEXT_PUBLIC_GA_ID=
GA_API_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# A/B tests to run (comma-separated): snapshot_price, preview_depth, email_timing, sub_offer.
# The paywall test is per quiz: set its paywall mode to "ab" in /admin.
EXPERIMENTS=

# --- Local development only (ignored in production) ---
# Checkouts succeed instantly with no Stripe account, through the same fulfilment code as the webhook.
DEV_FAKE_PAYMENTS=1
# Let draft quizzes sell reports so you can test checkout before content review.
ALLOW_DRAFT_SALES=false
# Make any dev sign-in an admin.
DEV_ADMIN=0
