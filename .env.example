# Copy to .env.local and fill in. Never commit real keys.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Supabase or Neon). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk → Webhooks → endpoint /api/webhooks/clerk, events user.created + user.updated
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints this locally
STRIPE_WEBHOOK_SECRET=whsec_...
# From `npm run stripe:setup`
STRIPE_PRICE_SNAPSHOT=price_...
STRIPE_PRICE_DEEP=price_...
STRIPE_PRICE_ALL_ACCESS=price_...
# Turn on once Stripe Tax is configured in the dashboard
STRIPE_AUTOMATIC_TAX=false

# Dev only: lets you test checkout on quizzes still marked "draft"
ALLOW_DRAFT_SALES=false
