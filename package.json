{
  "name": "quizplatform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "stripe:setup": "node --experimental-strip-types scripts/setup-stripe.ts",
    "content:registry": "node scripts/gen-registry.mjs",
    "check:content": "tsc --noEmit -p tsconfig.content.json",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.12",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
